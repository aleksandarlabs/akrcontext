  "hypothesis": "A shell before capsule binding makes first-mutation ordering unknown without removing the known mutation, capsule, or validation metrics.",
  "fixture": "trace-session",
  "suite": "smoke",
  "steps": [
    {
      "command": ["$AKRCTX", "hook", "SessionStart", "--akrctx-trace", "--akrctx-host", "claude"],
      "stdin": "{\"session_id\":\"unknown-order\",\"hook_event_name\":\"SessionStart\"}"
    },
    {
      "command": ["$AKRCTX", "hook", "PreToolUse", "--akrctx-trace", "--akrctx-host", "claude"],
