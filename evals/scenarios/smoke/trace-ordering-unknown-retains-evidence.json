    },
    {
      "command": ["$AKRCTX", "hook", "PreToolUse", "--akrctx-trace", "--akrctx-host", "claude"],
      "stdin": "{\"session_id\":\"unknown-order\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Read\",\"tool_input\":{\"file_path\":\".akrctx/tasks/TASK-001-eval/task.md\"}}"
