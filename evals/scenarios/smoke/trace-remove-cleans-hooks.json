{
  "id": "trace-remove-cleans-hooks",
  "title": "Full removal cleans owned trace wiring first",
  "changeType": "observability",
  "hypothesis": "remove --all unwires every host before deleting config while preserving foreign hooks.",
  "fixture": "trace-all-targets",
  "suite": "smoke",
  "steps": [
    {
      "command": ["$AKRCTX", "trace", "enable", "--json"]
    },
    {
      "command": ["$AKRCTX", "remove", "--all", "--purge-local", "--force", "--json"]
    }
  ],
  "assertions": [
    {
      "type": "exitCode",
      "step": 0,
      "equals": 0
    },
    {
      "type": "exitCode",
      "step": 1,
      "equals": 0
    },
    {
      "type": "fileNotExists",
      "path": ".akrctx/config.json"
    },
    {
      "type": "fileNotExists",
      "path": ".pi/extensions/akrctx-trace.ts"
    },
    {
      "type": "jsonPathEquals",
      "path": ".claude/settings.json",
      "jsonPath": "hooks.PreToolUse.0.hooks.0.command",
      "equals": "foreign-claude"
    },
    {
      "type": "jsonPathEquals",
      "path": ".codex/hooks.json",
      "jsonPath": "hooks.PostToolUse.0.hooks.0.command",
      "equals": "foreign-codex"
    },
    {
      "type": "jsonPathEquals",
      "path": ".github/hooks/akrctx-trace.json",
      "jsonPath": "hooks.PreToolUse.0.command",
      "equals": "foreign-copilot"
    }
  ],
  "comparison": {
    "baseExpected": "fail",
    "candidateExpected": "pass"
  },
  "outcome": {
    "metric": "orphaned-trace-hooks",
    "direction": "decrease",
    "verdict": "inconclusive"
  }
}
